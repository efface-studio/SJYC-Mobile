{
  "name": "sjyc-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --clear",
    "start:admin": "cross-env APP_FLAVOR=admin expo start --clear",
    "android": "expo run:android",
    "android:admin": "cross-env APP_FLAVOR=admin expo run:android",
    "ios": "expo run:ios",
    "ios:admin": "cross-env APP_FLAVOR=admin expo run:ios",
    "typecheck": "tsc --noEmit",
    "export:user": "expo export --platform ios --platform android --output-dir dist/user",
    "export:admin": "cross-env APP_FLAVOR=admin expo export --platform ios --platform android --output-dir dist/admin",
    "doctor": "expo-doctor",
    "sync:core": "node scripts/sync-core.mjs"
  },
  "dependencies": {
    "@expo/ui": "~57.0.7",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.104.0",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "pretendard": "^1.3.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "cross-env": "^10.0.0",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "react-dom": "19.2.3"
  }
}
