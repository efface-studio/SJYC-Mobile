{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "24.11.1"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "ios": { "simulator": true }
    },
    "development-admin": {
      "extends": "development",
      "env": { "APP_FLAVOR": "admin" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_MODE": "mock" }
    },
    "preview-admin": {
      "extends": "preview",
      "env": { "EXPO_PUBLIC_API_MODE": "mock", "APP_FLAVOR": "admin" }
    },
    "production": {
      "extends": "base",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_MODE": "http", "EXPO_PUBLIC_API_BASE_URL": "https://sjyc.efface.dev/api/v1" }
    },
    "production-admin": {
      "extends": "production",
      "env": {
        "EXPO_PUBLIC_API_MODE": "http",
        "EXPO_PUBLIC_API_BASE_URL": "https://sjyc.efface.dev/api/v1",
        "APP_FLAVOR": "admin"
      }
    }
  }
}
